{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with vehicles and emergency contacts in India",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "maxLength": 100
        },
        "avatar": {
          "type": "string",
          "maxLength": 500
        },
        "city": {
          "type": "string",
          "maxLength": 50
        },
        "emergencyContacts": {
          "type": "array",
          "description": "Indian emergency contact phone numbers"
        },
        "vehicles": {
          "type": "array",
          "description": "Registered Indian vehicles"
        },
        "savedLocations": {
          "type": "array",
          "description": "Saved Indian locations"
        }
      },
      "required": ["id", "name", "phone", "email"]
    },
    "Provider": {
      "title": "Provider",
      "description": "Verified roadside mechanics and towing partners across Indian hubs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "maxLength": 80
        },
        "emoji": {
          "type": "string",
          "maxLength": 10
        },
        "rating": {
          "type": "number"
        },
        "reviewsCount": {
          "type": "number"
        },
        "jobsCompleted": {
          "type": "number"
        },
        "yearsExperience": {
          "type": "number"
        },
        "etaMinutes": {
          "type": "number"
        },
        "distanceKm": {
          "type": "number"
        },
        "priceEstimate": {
          "type": "string",
          "maxLength": 50
        },
        "baseInspectionFee": {
          "type": "number"
        },
        "perKmRate": {
          "type": "number"
        },
        "skills": {
          "type": "array"
        },
        "expertise": {
          "type": "array"
        },
        "verified": {
          "type": "boolean"
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "currentStatus": {
          "type": "string",
          "enum": ["available", "busy", "offline"]
        }
      },
      "required": ["id", "name", "phone", "currentStatus"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Emergency roadside dispatch job order in India",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "providerId": {
          "type": "string",
          "maxLength": 128
        },
        "serviceType": {
          "type": "string",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "enum": ["sent", "accepted", "en_route", "in_progress", "completed", "cancelled"]
        },
        "otpCode": {
          "type": "string",
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "paid"]
        },
        "paymentMethod": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "providerId", "serviceType", "status"]
    },
    "SosAlert": {
      "title": "SosAlert",
      "description": "Emergency SOS broadcast alert in India",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "maxLength": 100
        },
        "userPhone": {
          "type": "string",
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": ["active", "resolved"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile collection"
    },
    "/providers/{providerId}": {
      "schema": {
        "$ref": "#/entities/Provider"
      },
      "description": "Roadside rescue providers in India"
    },
    "/bookings/{bookingId}": {
      "schema": {
        "$ref": "#/entities/Booking"
      },
      "description": "Emergency dispatch bookings"
    },
    "/sos_alerts/{sosId}": {
      "schema": {
        "$ref": "#/entities/SosAlert"
      },
      "description": "Emergency SOS broadcast broadcasts"
    }
  }
}
